{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "engine-diag",
  "version": "0.1.0",
  "identifier": "com.hp.engine-diag",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "engine-diag",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNzg4QkNGQ0Y0Q0YxMjEKUldRaDhVelB6NHQ0Z3RjSWdPQjRZclJaUGdkRTB2WG1yTHJuWDJmQlFnaUgyajN5OHNVd3N5Yi8K",
      "endpoints": [
        "https://github.com/radmar8985/engine-diag/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
